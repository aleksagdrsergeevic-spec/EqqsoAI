# Upstream provider keys — fill in at least one.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Anthropic (paid): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Client keys (sk-...) when there is no keys.json to write — containers
# wipe the filesystem on every deploy.
API_KEYS=

# Requests per minute per client key. 0 turns the ceiling off. Default 600.
RATE_LIMIT_RPM=

# Model used when a client asks for one the gateway does not serve
# (e.g. "claude-sonnet-4-5"). Default: gpt-oss-120b
DEFAULT_MODEL=

# Trial balance for a new account, in TKN. 0 turns it off. Default 10000.
WELCOME_TKN=

# Where the accounts, balances and codes live. Give it a volume in Docker.
DB_PATH=
